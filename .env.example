# ================= ฝั่ง SERVER (ลับ! ห้าม commit / ตั้งใน Vercel dashboard) =================
# Service account email จาก Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com

# Private key จากไฟล์ JSON ของ service account (ใส่ทั้งก้อนในเครื่องหมายคำพูด, \n คงไว้)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Sheet ID จาก URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit
SHEET_ID=
MANPOWER_FILE_ID=1QsxLIAc9EOg681_2YiRYFqRTSpZDaJhg

# ข้อมูลพนักงาน/ผู้สมัครงาน (หน้า "ข้อมูลพนักงาน") — Google Sheet แยกต่างหาก ที่ผูกกับ Google Form
# ต้องแยกจาก SHEET_ID เพราะเก็บ PII (เลขบัตร ปชช/ทะเบียนบ้าน) และห้ามเปิดแชร์แบบลิงก์
# แชร์ชีตนี้ให้ service account (สิทธิ์ผู้อ่าน). ไม่ตั้ง = หน้าเว็บโชว์ขั้นตอนติดตั้งแทน
HR_SHEET_ID=
# ชื่อแท็บคำตอบของฟอร์ม (default: employees / applicants) — เปลี่ยนชื่อแท็บในชีตให้ตรง หรือ override ที่นี่
HR_EMP_TAB=employees
HR_APPLICANT_TAB=applicants

# Secret สำหรับระบบ login รายบัญชี (สำคัญมากตอน deploy — ไม่ตั้ง = API เปิดโล่ง ใครก็อ่าน/เขียนข้อมูลได้)
# ตั้งเป็นข้อความสุ่มยาวๆ (ใช้เซ็น token ไม่ใช่รหัสผ่านผู้ใช้) — เปิดเว็บครั้งแรกจะให้สร้างบัญชี admin
AUTH_SECRET=

# ================= ฝั่ง CLIENT (Vite จะฝังลงในโค้ดหน้าเว็บ — ห้ามใส่ของลับ) =================
VITE_SHEET_ID=
