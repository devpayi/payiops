{
  "name": "mona-ops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "core:install": "npm ci --prefix backend/core",
    "core:typecheck": "npm run typecheck --prefix backend/core",
    "core:build": "npm run build --prefix backend/core",
    "core:test": "npm test --prefix backend/core",
    "core:start": "npm start --prefix backend/core",
    "ops:setup": "npm run local:setup --prefix backend/core",
    "ops:build": "npm run core:build && npm run build --prefix backend/core/apps/web",
    "ops:start": "npm run local:start --prefix backend/core",
    "ops:backup": "npm run local:backup --prefix backend/core",
    "ops:verify-backup": "npm run local:verify-backup --prefix backend/core",
    "preview": "vite preview",
    "ops:install": "npm run core:install && npm ci --prefix backend/core/database/tests && npm ci --prefix backend/core/apps/web && powershell -NoProfile -File backend/core/scripts/install-free.ps1"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.3.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.17.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  }
}
