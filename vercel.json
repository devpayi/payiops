{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/sheet-tools?op=inventory&cron=low-stock", "schedule": "0 11 * * *" },
    { "path": "/api/sheet-tools?op=workforce&cron=holiday-reminder", "schedule": "0 2 * * *" }
  ]
}
