{
  "name": "cmo-cfo-procurement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/*", "apps/api"],
  "scripts": {
    "local:setup": "tsx scripts/local.ts setup",
    "local:start": "tsx scripts/local.ts start",
    "local:stop": "tsx scripts/local.ts stop",
    "local:backup": "tsx scripts/local.ts backup",
    "local:verify-backup": "tsx scripts/local.ts verify-backup",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "start": "node dist/apps/api/src/server.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "5.9.3",
    "tsx": "4.23.13"
  }
}
